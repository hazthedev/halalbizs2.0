APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# M-31: send X-Robots-Tag: noindex on every response. Turn this ON for the
# preview — it is publicly reachable and carries demo sellers and demo stock.
# Leave it OFF (the default) in real production.
# SITE_NOINDEX=true

# Token-gated HTTPS deploy webhook (public/deploy.php → deploy.sh).
# Set to a long random string on the server only; leave blank to disable.
DEPLOY_TOKEN=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Auth cookie Secure flag. Defaults to true outside local/testing
# (config/session.php) — only set this explicitly to override that default,
# e.g. SESSION_SECURE_COOKIE=false if a production host somehow isn't HTTPS
# yet (AL-C11). Requires HSTS/trustProxies (bootstrap/app.php) to be correct
# for the browser to actually see the connection as secure behind a proxy.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Production: MAIL_MAILER=smtp + real MAIL_HOST/PORT/USERNAME/PASSWORD and
# MAIL_FROM_*. Postmark/Resend/SES appear in config/mail.php but their SDKs are
# NOT installed — SMTP is the only working production transport.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# HalalBizs app-owned env surface (AL-C12) — every key the app itself reads,
# with the value it should carry on the PRODUCTION host. Everything below is
# commented/inert by default so local dev keeps today's behaviour untouched;
# uncomment + fill in per key as each integration goes live. Cross-check
# against config/*.php if a default ever looks stale — this list mirrors what
# those files read as of 2026-07-27.
# =============================================================================

# --- Store subdomains (config/app.php) --------------------------------------
# Base domain for {slug}.<base> storefront links. Falls back to APP_URL's own
# host when unset (AL-C10) — set explicitly once wildcard DNS + a wildcard
# cert exist in production.
# STORE_SUBDOMAIN_BASE=example.com
# STORE_SUBDOMAINS=true
#
# ⚠ M-30: SESSION_DOMAIN above is `null`, which makes a HOST-ONLY cookie — so
# turning STORE_SUBDOMAINS on without setting it means a logged-in buyer is
# ANONYMOUS the moment they land on a store subdomain, cart and all. The leading
# dot is required.
# SESSION_DOMAIN=.example.com

# --- iPay88 (config/services.php, App\Settings\Ipay88Settings) -------------
# Merchant code/key live in the admin-managed Ipay88Settings, not env. This
# only gates the built-in payment SIMULATOR: local dev enables it implicitly;
# every other environment (including a "production" preview) must opt in
# explicitly, so a real prod boot can never hand out free "paid" orders.
# IPAY88_ALLOW_MOCK=false
# Optional automated-refund API endpoint (only on some merchant contracts).
# IPAY88_REFUND_URL=

# --- EasyParcel courier aggregator (config/shipping.php) --------------------
# EASYPARCEL_ENABLED=false
# EASYPARCEL_API_KEY=
# EASYPARCEL_BASE_URL=https://connect.easyparcel.my
# EASYPARCEL_SANDBOX=false
# EASYPARCEL_ORIGIN_POSTCODE=
# EASYPARCEL_ORIGIN_STATE=
# Read from the X-EasyParcel-Token header or POST body only (AL-C15) — never
# put this in the webhook URL's query string (it lands in access logs).
# EASYPARCEL_WEBHOOK_TOKEN=

# --- E-invoicing / LHDN MyInvois (config/einvoice.php) ----------------------
# 'null' records documents locally without filing — safe default until the
# platform has Intermediary credentials + a signing cert.
# EINVOICE_PROVIDER=null
# EINVOICE_INDIVIDUAL_THRESHOLD_SEN=1000000
# EINVOICE_PLATFORM_NAME=HalalBizs
# EINVOICE_PLATFORM_TIN=
# MYINVOIS_SANDBOX=false
# MYINVOIS_BASE_URL=https://api.myinvois.hasil.gov.my
# MYINVOIS_IDENTITY_URL=https://api.myinvois.hasil.gov.my
# MYINVOIS_CLIENT_ID=
# MYINVOIS_CLIENT_SECRET=
# MYINVOIS_ON_BEHALF_OF=
# MYINVOIS_SIGNING_CERT_PATH=
# MYINVOIS_SIGNING_KEY_PATH=

# --- Search (config/scout.php, config/search.php) ---------------------------
# Scout keyword search. ⚠ 'meilisearch' requires `composer require
# meilisearch/meilisearch-php`, which is NOT installed — setting it without the
# client breaks keyword search. Leave SCOUT_DRIVER unset: keyword search runs on
# the built-in SQL path (Product::keywordSearch), which is what production uses.
# SCOUT_DRIVER=collection
# MEILISEARCH_HOST=http://127.0.0.1:7700
# MEILISEARCH_KEY=
# Semantic/visual search embedder. 'local' is deterministic/no-network
# (dev/tests); 'remote' calls a real embedding model. ⚠ ONE flag gates BOTH
# modes: SEARCH_SEMANTIC_ENABLED=false makes smart text search fall back to
# keyword AND 404s /search/visual.
# SEARCH_SEMANTIC_ENABLED=true
# SEARCH_EMBED_DRIVER=remote
# SEARCH_EMBED_URL=
# SEARCH_EMBED_KEY=
# SEARCH_EMBED_MODEL=voyage-3
# SEARCH_EMBED_TIMEOUT=20
# ⚠ Changing SEARCH_EMBED_DIMS invalidates EVERY stored vector — run
# `php artisan search:embed` immediately after deploying a change (deploy.sh
# does NOT run it).
# SEARCH_EMBED_DIMS=4096

# --- WhatsApp Cloud API (config/services.php) — OTP delivery -----------------
# Unset = OTP sends go to the log (LogSmsSender). Real sends need BOTH token and
# phone_number_id, plus an approved "authentication" template in Meta Business
# Manager. See AppServiceProvider for the binding.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE=verification_code
# WHATSAPP_TEMPLATE_LANG=en
# WHATSAPP_API_VERSION=v21.0

# --- Affiliate programme (config/affiliate.php) ------------------------------
# AFFILIATE_ENABLED=true
# AFFILIATE_COMMISSION_BP=500
# AFFILIATE_MIN_PAYOUT_SEN=5000
# AFFILIATE_COOKIE_DAYS=30
# Days added past the return window before a referral commission unlocks:
# AFFILIATE_LOCK_BUFFER_DAYS=7

# --- Anthropic Claude (config/services.php) — AI listing copy + concierge ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# CONCIERGE_ENABLED=true

# --- Cloudflare Turnstile (config/services.php) -----------------------------
# Keys themselves live in the admin panel (SecuritySettings). With NO keys
# configured, register/login now FAIL CLOSED outside local/testing (AL-C7) —
# a host that deliberately runs without Turnstile (e.g. the preview) must set
# this to true until real keys exist.
# TURNSTILE_ALLOW_UNCONFIGURED=false

# --- Backups (config/backup.php) --------------------------------------------
# BACKUP_DISK=local
# BACKUP_RETENTION_DAYS=14

# --- Settlement + geo (config/payments.php) ---------------------------------
# SETTLEMENT_CURRENCY=MYR
# GEO_DEFAULT_COUNTRY=MY
# GEO_PRICE_COUNTRY=MY

# --- ⚠ DEMO DATA — MUST BE ABSENT IN REAL PRODUCTION (deploy.sh:114) ---------
# Read by deploy.sh, NOT by config/. Deliberately independent of APP_ENV,
# because the preview correctly runs APP_ENV=production and still wants demo
# inventory. Setting it true on a real production host means:
#   · 19 seller accounts (<brand>@halalbizs.test, derived from store names that
#     are PRINTED ON THE STOREFRONT), email-verified and force-approved, whose
#     password is re-randomised and re-printed in the deploy log every deploy
#   · 166 demo SKUs + demo certificates in the live catalogue
#   · CategorySeeder DEACTIVATES every category outside the demo tree
# Cutover check: `grep -n SEED_DEMO_CATALOGUE .env` on the host must find
# nothing, and no *@halalbizs.test user may exist.
# SEED_DEMO_CATALOGUE=false

# Halal publish gate (audit H-6). Products in a category flagged
# requires_halal_certificate need an approved certificate to stay live.
# UNSET = report-only, which is the correct state until sellers have actually
# registered their certificates. Setting a date already in the PAST darks every
# uncertified food listing the moment the config cache rebuilds — pick a date
# far enough ahead that sellers can act on the 90-day renewal nudge first.
# HALAL_GATE_ENFORCED_FROM=2026-12-01

# Admin seeded by AdminUserSeeder (create-only, never run by deploy.sh). With
# no ADMIN_PASSWORD set, a production seed gets a random password nobody knows
# — reset it via `php artisan tinker` rather than guessing.
# ADMIN_EMAIL=admin@halalbizs.test
# ADMIN_PASSWORD=
