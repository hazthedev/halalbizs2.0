APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Token-gated HTTPS deploy webhook (public/deploy.php → deploy.sh).
# Set to a long random string on the server only; leave blank to disable.
DEPLOY_TOKEN=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Auth cookie Secure flag. Defaults to true outside local/testing
# (config/session.php) — only set this explicitly to override that default,
# e.g. SESSION_SECURE_COOKIE=false if a production host somehow isn't HTTPS
# yet (AL-C11). Requires HSTS/trustProxies (bootstrap/app.php) to be correct
# for the browser to actually see the connection as secure behind a proxy.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# HalalBizs app-owned env surface (AL-C12) — every key the app itself reads,
# with the value it should carry on the PRODUCTION host. Everything below is
# commented/inert by default so local dev keeps today's behaviour untouched;
# uncomment + fill in per key as each integration goes live. Cross-check
# against config/*.php if a default ever looks stale — this list mirrors what
# those files read as of 2026-07-27.
# =============================================================================

# --- Store subdomains (config/app.php) --------------------------------------
# Base domain for {slug}.<base> storefront links. Falls back to APP_URL's own
# host when unset (AL-C10) — set explicitly once wildcard DNS + a wildcard
# cert exist in production.
# STORE_SUBDOMAIN_BASE=example.com
# STORE_SUBDOMAINS=true

# --- iPay88 (config/services.php, App\Settings\Ipay88Settings) -------------
# Merchant code/key live in the admin-managed Ipay88Settings, not env. This
# only gates the built-in payment SIMULATOR: local dev enables it implicitly;
# every other environment (including a "production" preview) must opt in
# explicitly, so a real prod boot can never hand out free "paid" orders.
# IPAY88_ALLOW_MOCK=false
# Optional automated-refund API endpoint (only on some merchant contracts).
# IPAY88_REFUND_URL=

# --- EasyParcel courier aggregator (config/shipping.php) --------------------
# EASYPARCEL_ENABLED=false
# EASYPARCEL_API_KEY=
# EASYPARCEL_BASE_URL=https://connect.easyparcel.my
# EASYPARCEL_SANDBOX=false
# EASYPARCEL_ORIGIN_POSTCODE=
# EASYPARCEL_ORIGIN_STATE=
# Read from the X-EasyParcel-Token header or POST body only (AL-C15) — never
# put this in the webhook URL's query string (it lands in access logs).
# EASYPARCEL_WEBHOOK_TOKEN=

# --- E-invoicing / LHDN MyInvois (config/einvoice.php) ----------------------
# 'null' records documents locally without filing — safe default until the
# platform has Intermediary credentials + a signing cert.
# EINVOICE_PROVIDER=null
# EINVOICE_INDIVIDUAL_THRESHOLD_SEN=1000000
# EINVOICE_PLATFORM_NAME=HalalBizs
# EINVOICE_PLATFORM_TIN=
# MYINVOIS_SANDBOX=false
# MYINVOIS_BASE_URL=https://api.myinvois.hasil.gov.my
# MYINVOIS_IDENTITY_URL=https://api.myinvois.hasil.gov.my
# MYINVOIS_CLIENT_ID=
# MYINVOIS_CLIENT_SECRET=
# MYINVOIS_ON_BEHALF_OF=
# MYINVOIS_SIGNING_CERT_PATH=
# MYINVOIS_SIGNING_KEY_PATH=

# --- Search (config/scout.php, config/search.php) ---------------------------
# Scout keyword search. 'collection' (in-memory, local-only) in dev;
# 'meilisearch' in production.
# SCOUT_DRIVER=meilisearch
# MEILISEARCH_HOST=http://127.0.0.1:7700
# MEILISEARCH_KEY=
# Semantic/visual search embedder. 'local' is deterministic/no-network
# (dev/tests); 'remote' calls a real embedding model in production.
# SEARCH_SEMANTIC_ENABLED=true
# SEARCH_EMBED_DRIVER=remote
# SEARCH_EMBED_URL=
# SEARCH_EMBED_KEY=
# SEARCH_EMBED_MODEL=voyage-3

# --- Anthropic Claude (config/services.php) — AI listing copy + concierge ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# CONCIERGE_ENABLED=true

# --- Backups (config/backup.php) --------------------------------------------
# BACKUP_DISK=local
# BACKUP_RETENTION_DAYS=14

# --- Settlement + geo (config/payments.php) ---------------------------------
# SETTLEMENT_CURRENCY=MYR
# GEO_DEFAULT_COUNTRY=MY
# GEO_PRICE_COUNTRY=MY
