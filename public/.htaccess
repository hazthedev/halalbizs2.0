# HB-G081: do not advertise the PHP version. "always" and the default table
# both, because PHP-set headers land in the default one.
<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header unset X-Powered-By
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # HB-G178: www is not a store. routes/web.php's {store:slug} subdomain
    # route would take "www" as a slug and 404, so send it to the bare host
    # first (one hop, http or https). Query string carries over by default.
    RewriteCond %{HTTP_HOST} ^www\.halalbizs\.com(:\d+)?$ [NC]
    RewriteRule ^ https://halalbizs.com%{REQUEST_URI} [L,R=301]

    # ENV-11 / HB-G098: plain http on the live bare host goes to https. Host
    # guard keeps local (*.test) and the testing copy untouched. TLS ends in
    # LiteSpeed itself today (HTTPS=on); the X-Forwarded-Proto guard stops a
    # loop if a TLS proxy is ever put in front.
    RewriteCond %{HTTP_HOST} ^halalbizs\.com(:\d+)?$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https [NC]
    RewriteRule ^ https://halalbizs.com%{REQUEST_URI} [L,R=301]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
